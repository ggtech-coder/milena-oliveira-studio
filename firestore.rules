rules_version = '2';
// Regras do banco. Cole no Console do Firebase > Firestore Database > Regras e clique em Publicar.
// O UID em master() é o do administrador master (o mesmo de MASTER em firebase-config.js).
// A equipe do painel fica em /usuarios/{uid} com {ativo, perms:{dash, agenda, caixa, clientes, travar, config}}.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function master() { return logado() && request.auth.uid == "6tZbvEYyicTYlt8LnaVoXwJtDmS2"; }
    function equipe() {
      return master() || (logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true);
    }
    function pode(p) {
      return master() || (equipe()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perms.get(p, false) == true);
    }
    function horario(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is int && d.end is int && d.start >= 0 && d.end > d.start && d.end <= 1440;
    }
    // com o servidor de pagamento configurado, a reserva do site nasce "aguardando" (pagamento);
    // sem ele, nasce "reservado" e a equipe confere o sinal à mão
    function comPagamento() {
      return exists(/databases/$(database)/documents/config/site)
        && get(/databases/$(database)/documents/config/site).data.get("pagURL", "") != "";
    }

    // horários, preços, textos do site: todos leem, só quem tem a permissão "config" altera
    match /config/{id} {
      allow read: if true;
      allow write: if pode("config");
    }

    // horários ocupados e travados: o site lê para mostrar só os horários livres
    match /ocupado/{id} {
      allow read: if true;
      // agendar não exige conta: o site reserva o horário junto com o agendamento
      allow create: if pode("agenda") || pode("travar") || (
        request.resource.data.keys().hasOnly(["date", "start", "end", "tipo"])
        && request.resource.data.tipo == "agenda" && horario(request.resource.data));
      allow update: if pode("agenda") || pode("travar");
      // a cliente libera o horário ao cancelar o próprio agendamento (mesmo id)
      allow delete: if pode("agenda") || pode("travar") || (logado()
        && exists(/databases/$(database)/documents/agendamentos/$(id))
        && get(/databases/$(database)/documents/agendamentos/$(id)).data.get("uid", "") == request.auth.uid);
    }

    // agendamentos: no site qualquer cliente cria, sem conta; só a equipe lê todos.
    // A cliente vê os dela pelo PIN, através do servidor (pagamentos/worker.js).
    // Quem tem conta antiga continua vendo e cancelando os seus pelo uid.
    match /agendamentos/{id} {
      allow read: if (logado() && resource.data.get("uid", "") == request.auth.uid) || equipe();
      // equipe muda tudo; a cliente só pode cancelar um agendamento dela que ainda está ativo
      allow update: if pode("agenda") || (logado()
        && resource.data.get("uid", "") == request.auth.uid
        && resource.data.status in ["aguardando", "reservado", "confirmado"]
        && request.resource.data.status == "cancelado"
        && request.resource.data.canceladoPor == "cliente"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "motivo", "canceladoPor", "canceladoEm", "retido"]));
      allow delete: if master();
      allow create: if pode("agenda") || (
        request.resource.data.keys().hasOnly(["code", "svc", "itens", "ex", "date", "dateTxt", "start", "end",
          "total", "dep", "pay", "name", "tel", "telKey", "obs", "status", "criado"])
        && request.resource.data.telKey is string && request.resource.data.telKey.matches('^[0-9]{10,11}$')
        && ((comPagamento() && request.resource.data.status == "aguardando")
          || (!comPagamento() && request.resource.data.status == "reservado"))
        && request.resource.data.criado == request.time
        && horario(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 30
        && request.resource.data.tel.replace('[^0-9]', '') == request.resource.data.telKey
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 1000
        && existsAfter(/databases/$(database)/documents/ocupado/$(id)));
    }

    // PIN das clientes: ninguém lê pelo navegador (só o servidor); a equipe pode criar um novo se ela esquecer
    match /pins/{tel} {
      allow create, update: if pode("clientes");
    }

    // equipe do painel: só o master cria, muda e remove; cada um lê o próprio cadastro
    match /usuarios/{uid} {
      allow read: if master() || (logado() && request.auth.uid == uid);
      allow write: if master();
    }

    // contas das clientes do site: cada cliente lê e edita a sua; a equipe lê todas
    match /clientes/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || equipe();
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["nome", "tel", "email", "criado"])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 30;
      allow delete: if master();
    }
  }
}
