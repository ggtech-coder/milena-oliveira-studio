rules_version = '2';
// Regras do banco. Cole no Console do Firebase > Firestore Database > Regras e clique em Publicar.
// O UID abaixo é o do seu usuário (Authentication > Usuários). Para dar acesso a outra pessoa, some o UID dela na lista.
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid in ["6tZbvEYyicTYlt8LnaVoXwJtDmS2"];
    }
    function horario(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.start is int && d.end is int && d.start >= 0 && d.end > d.start && d.end <= 1440;
    }

    // horários, preços e durações: o site lê, só você altera
    match /config/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // horários ocupados e travados: o site lê para mostrar só os horários livres
    match /ocupado/{id} {
      allow read: if true;
      allow create: if admin() || (
        request.resource.data.keys().hasOnly(["date", "start", "end", "tipo"])
        && request.resource.data.tipo == "agenda" && horario(request.resource.data));
      allow update, delete: if admin();
    }

    // dados das clientes: o site só cria; ler, mudar e apagar é só com você logada
    match /agendamentos/{id} {
      allow read, update, delete: if admin();
      allow create: if admin() || (
        request.resource.data.status == "reservado"
        && request.resource.data.criado == request.time
        && horario(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.tel is string && request.resource.data.tel.size() <= 30
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 1000
        && existsAfter(/databases/$(database)/documents/ocupado/$(id)));
    }
  }
}
